# EagleReach backend configuration (copy to backend/.env for local overrides)
#
# The open-data backend runs with NO API keys by default. Every source it
# calls (Zippopotam, FCC, GovTrack, Wikidata, Open-Meteo, city 311 portals)
# is public and keyless. The variables below are optional.

# Optional: U.S. Census geocoder key. Not required — the Census endpoints
# used by providers/free_civic.py work without one, but supplying a key
# raises your rate limits. Request one at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Optional: comma-separated list of extra origins allowed to call the API,
# in addition to the built-in GitHub Pages / localhost origins.
# Example: EXTRA_ALLOWED_ORIGINS=https://example.org,https://staging.example.org
EXTRA_ALLOWED_ORIGINS=
